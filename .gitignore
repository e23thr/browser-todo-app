# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
coverage/
# Coverage run output of the e2e-b run (istanbul artifacts) — regenerated, never committed (D5).
coverage-e2b/
*.tsbuildinfo

# Test artifacts
test-results/
playwright-report/
blob-report/
.playwright/

# Lighthouse CI reports (perf-budget gate): .lighthouseci is LHCI's scratch dir, lighthouse-reports/
# is the archived per-preset run set the perf-budget CI job uploads as an artifact (7 days).
.lighthouseci/
lighthouse-reports/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local env / secrets — never commit
.env
.env.*
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# E2E fixture builds (ADR-005 Decision 9): rebuilt per run by tests/e2e/fixtures/build-fixtures.mjs
tests/e2e/.fixtures/