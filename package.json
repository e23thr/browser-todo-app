{
  "name": "browser-todo-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Privacy-first, local-first todo web app — static build deployed to GitHub Pages.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-precache.mjs && node scripts/build-sw.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "budget": "node scripts/check-bundle-budget.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "audit:gate": "npm audit --omit=dev --audit-level=high",
    "e2e:install": "playwright install chromium",
    "e2e": "playwright test --project=chromium",
    "e2e:smoke": "playwright test --project=chromium tests/e2e/smoke.spec.ts",
    "e2e:a11y": "playwright test --project=chromium tests/e2e/a11y.spec.ts",
    "e2e:sw": "playwright test --config playwright.sw.config.ts",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run i18n:check && npm run test:coverage && npm run build && npm run budget"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "idb": "^8.0.4",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fake-indexeddb": "^6.2.6",
    "globals": "^16.5.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
